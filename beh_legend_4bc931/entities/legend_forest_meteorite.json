{
    "format_version": "1.12.0",
    "minecraft:entity": {
        "component_groups": {
            "legend_forest:hanging": {
                "minecraft:timer": {
                    "looping": false,
                    "time": [0.8, 0.8],
                    "time_down_event": {
                        "event": "legend_forest:falling"
                    }
                }
            },
            "legend_forest:falling": {
                "minecraft:physics": {},
                "minecraft:timer": {
                    "looping": true,
                    "time": [0.1, 0.1],
                    "time_down_event": {
                        "event": "legend_forest:exploded"
                    }
                }
            },
            "legend_forest:explosion": {
                "minecraft:explode": {
                    "breaks_blocks": false,
                    "fuse_length": 0,
                    "fuse_lit": true,
                    "power": 2
                }
            }
        },
        "components": {
            "netease:ban_bandwidth_optimization": {},
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": false
                }
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:scale": {
                "value": 1.2
            },
            "minecraft:health": {
                "max": 1.0,
                "value": 1.0
            },
            "minecraft:underwater_movement": {
                "value": 0.15
            }
        },
        "description": {
            "identifier": "legend_forest:meteorite",
            "is_experimental": false,
            "is_spawnable": false,
            "is_summonable": true
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "legend_forest:hanging"
                    ]
                }
            },
            "legend_forest:falling": {
                "add": {
                    "component_groups": [
                        "legend_forest:falling"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "legend_forest:hanging"
                    ]
                }
            },
            "legend_forest:exploded": {
                "sequence": [
                    {
                        "filters": {
                            "test": "on_ground"
                        },
                        "add": {
                            "component_groups": [
                                "legend_forest:explosion"
                            ]
                        },
                        "remove": {
                            "component_groups": [
                                "legend_forest:falling"
                            ]
                        }
                    }
                ]
            }
        }
    }
}