{
    "format_version": "1.12.0",
    "minecraft:entity": {
        "component_groups": {
            "legend_forest:magic_deer_can_hunt": {
                "minecraft:type_family": {
                    "family": [
                        "mob",
                        "deer",
                        "can_hunt"
                    ]
                }
            },
            "minecraft:magic_deer_adult": {
                "minecraft:behavior.breed": {
                    "priority": 3,
                    "speed_multiplier": 0.8
                },
                "minecraft:behavior.hurt_by_target": {
                    "alert_same_type": true,
                    "entity_types": [
                        {
                            "filters": {
                                "any_of": [
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "player"
                                    }
                                ]
                            },
                            "max_dist": 20
                        },
                        {
                            "filters": {
                                "any_of": [
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "goblin"
                                    }
                                ]
                            },
                            "max_dist": 20
                        }
                    ]
                },
                "minecraft:behavior.nearest_attackable_target": {
                    "attack_interval": 5,
                    "entity_types": [
                        {
                            "filters": {
                                "any_of": [
                                ]
                            },
                            "max_dist": 8
                        }
                    ],
                    "must_see": true,
                    "priority": 0,
                    "reselect_targets": true
                },
                "minecraft:breedable": {
                    "breed_items": [
                        "minecraft:glow_berries"
                    ],
                    "breeds_with": {
                        "baby_type": "legend_forest:magic_deer",
                        "breed_event": {
                            "event": "minecraft:entity_born",
                            "target": "baby"
                        },
                        "mate_type": "legend_forest:magic_deer"
                    },
                    "require_tame": false
                },
                "minecraft:experience_reward": {
                    "on_bred": "Math.Random(1,7)",
