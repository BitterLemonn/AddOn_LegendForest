            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.look_at_player": {
                "look_distance": 8,
                "priority": 6
            },
            "minecraft:behavior.melee_attack": {
                "priority": 1,
                "reach_multiplier": 1.65,
                "speed_multiplier": 1.0,
                "track_target": true
            },
            "minecraft:behavior.random_stroll": {
                "priority": 8,
                "speed_multiplier": 0.8
            },
            "minecraft:behavior.tempt": {
                "items": [
                    "minecraft:glow_berries"
                ],
                "priority": 4,
                "speed_multiplier": 1.0
            },
            "minecraft:collision_box": {
                "height": 1.65,
                "width": 1.0
            },
            "minecraft:health": {
                "max": 30.0,
                "value": 30.0
            },
            "minecraft:jump.static": {
            },
            "minecraft:movement": {
                "value": 0.35
            },
            "minecraft:movement.basic": {
                "max_turn": 30.0
            },
            "minecraft:nameable": {
            },
            "minecraft:navigation.walk": {
                "avoid_water": true,
                "can_open_doors": false,
                "can_pass_doors": true,
                "can_path_over_water": false,
                "can_walk": true
            },
            "minecraft:on_target_acquired": {
                "event": "minecraft:become_angry",
                "target": "self"
            },
            "minecraft:physics": {
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:scale": {
                "value": 1
            },
            "minecraft:type_family": {
                "family": [
                    "mob",
                    "deer",
                    "animals"
                ]
            },
            "minecraft:underwater_movement": {
                "value": 0.15
            }
        },
        "description": {
            "identifier": "legend_forest:magic_deer",
            "is_experimental": false,
            "is_spawnable": true,
            "is_summonable": true,
            "runtime_identifier": "legend_forest:magic_deer"
        },
        "events": {
            "legend_forest:deer_can_hunt": {
                "add": {
                    "component_groups": [
                        "legend_forest:magic_deer_can_hunt"
                    ]
                }
            },
            "minecraft:ageable_grow_up": {
                "add": {
                    "component_groups": [
                        "minecraft:magic_deer_adult"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "minecraft:magic_deer_baby"
                    ]
                }
            },
            "minecraft:become_angry": {
                "add": {
                    "component_groups": [
                        "minecraft:magic_deer_angry"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "minecraft:magic_deer_calm"
                    ]
                }
            },
            "minecraft:entity_born": {
                "add": {
                    "component_groups": [
                        "minecraft:magic_deer_baby"
                    ]
                },
                "remove": {
                }
            },
            "minecraft:entity_spawned": {
                "randomize": [
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_adult",
                                "minecraft:magic_deer_calm"
                            ]
                        },
                        "weight": 60
                    },
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_adult",
                                "minecraft:magic_deer_calm",
                                "legend_forest:magic_deer_can_hunt"
                            ]
                        },
                        "weight": 35
                    },
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_baby",
                                "minecraft:magic_deer_calm"
                            ]
                        },
                        "weight": 5
                    }
                ]
            },
            "minecraft:entity_transformed": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_baby",
                                "minecraft:magic_deer_calm"
                            ]
                        },
                        "filters": {
                            "subject": "other",
                            "test": "has_component",
                            "value": "minecraft:is_baby"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_adult",
                                "minecraft:magic_deer_calm"
                            ]
                        },
                        "filters": {
                            "operator": "!=",
                            "subject": "other",
                            "test": "has_component",
                            "value": "minecraft:is_baby"
                        }
                    }
                ]
            },
            "minecraft:on_calm": {
                "add": {
                    "component_groups": [
                        "minecraft:magic_deer_calm"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "minecraft:magic_deer_angry"
                    ]
                }
            }
        }
    }
}