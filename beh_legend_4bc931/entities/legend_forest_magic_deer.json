{
    "format_version": "1.21.90",
    "minecraft:entity": {
        "component_groups": {
            "legend_forest:magic_deer_can_hunt": {
                "minecraft:type_family": {
                    "family": ["mob", "deer", "animals", "can_hunt"]
                }
            },
            "minecraft:magic_deer_adult": {
                "minecraft:behavior.breed": {
                    "priority": 3,
                    "speed_multiplier": 0.8
                },
                "minecraft:behavior.hurt_by_target": {
                    "alert_same_type": true,
                    "entity_types": [
                        {
                            "filters": {
                                "any_of": [
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "player"
                                    }
                                ]
                            },
                            "max_dist": 20
                        },
                        {
                            "filters": {
                                "any_of": [
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "goblin"
                                    }
                                ]
                            },
                            "max_dist": 20
                        }
                    ]
                },
                "minecraft:behavior.nearest_attackable_target": {
                    "attack_interval": 5,
                    "must_see": true,
                    "priority": 0,
                    "reselect_targets": true
                },
                "minecraft:breedable": {
                    "breed_items": ["minecraft:glow_berries"],
                    "breeds_with": {
                        "baby_type": "legend_forest:magic_deer",
                        "breed_event": {
                            "event": "minecraft:entity_born",
                            "target": "baby"
                        },
                        "mate_type": "legend_forest:magic_deer"
                    },
                    "require_tame": false
                },
                "minecraft:experience_reward": {
                    "on_bred": "Math.Random(1,7)",
                    "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
                },
                "minecraft:loot": {
                    "table": "loot_tables/legend_forest/entities/magic_deer.json"
                },
                "minecraft:timer": {
                    "looping": false,
                    "time": [60, 300],
                    "time_down_event": {
                        "event": "legend_forest:deer_can_hunt"
                    }
                }
            },
            "minecraft:magic_deer_angry": {
                "minecraft:angry": {
                    "broadcast_anger": true,
                    // 限定只传染给同族(deer);否则会波及 nearby 共用 animals 族的其他生物(如野猪)
                    "broadcast_targets": ["deer"],
                    "broadcast_range": 20,
                    "calm_event": {
                        "event": "minecraft:on_calm",
                        "target": "self"
                    },
                    "duration": 25
                }
            },
            "minecraft:magic_deer_baby": {
                "minecraft:ageable": {
                    "duration": 1200,
                    "feed_items": ["minecraft:glow_berries"],
                    "grow_up": {
                        "event": "minecraft:ageable_grow_up",
                        "target": "self"
                    }
                },
                "minecraft:behavior.follow_parent": {
                    "priority": 5,
                    "speed_multiplier": 1.1
                },
                "minecraft:experience_reward": {
                    "on_death": "query.last_hit_by_player ? 2 + (query.equipment_count * Math.Random(1,3)) : 0"
                },
                "minecraft:is_baby": {},
                "minecraft:scale": {
                    "value": 0.65
                }
            },
            "minecraft:magic_deer_variant_0": {
                "minecraft:variant": {
                    "value": 0
                }
            },
            "minecraft:magic_deer_variant_1": {
                "minecraft:variant": {
                    "value": 1
                }
            },
            "minecraft:magic_deer_variant_2": {
                "minecraft:variant": {
                    "value": 2
                }
            },
            "minecraft:magic_deer_variant_3": {
                "minecraft:variant": {
                    "value": 3
                }
            }
        },
        "components": {
            "minecraft:despawn": {
                "despawn_from_distance": {}
            },
            "minecraft:attack": {
                "damage": 3.0,
                "effect_duration": 20,
                "effect_name": "Nausea"
            },
            "minecraft:behavior.avoid_mob_type": {
                "avoid_mob_sound": "retreat",
                "entity_types": [
                    {
                        "filters": {
                            "any_of": [
                                {
                                    "subject": "other",
                                    "test": "is_family",
                                    "value": "goblin"
                                }
                            ]
                        },
                        "max_dist": 6
                    }
                ],
                "priority": 4,
                "remove_target": false,
                "sound_interval": {
                    "range_max": 5.0,
                    "range_min": 2.0
                }
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.look_at_player": {
                "look_distance": 8,
                "priority": 6
            },
            "minecraft:behavior.random_stroll": {
                "priority": 8,
                "speed_multiplier": 0.8
            },
            "minecraft:behavior.tempt": {
                "items": ["minecraft:glow_berries"],
                "priority": 4,
                "speed_multiplier": 1.0
            },
            "minecraft:collision_box": {
                "height": 1.65,
                "width": 1.0
            },
            "minecraft:health": {
                "max": 30.0,
                "value": 30.0
            },
            "minecraft:jump.static": {},
            "minecraft:movement": {
                "value": 0.3
            },
            "minecraft:movement.basic": {},
            "minecraft:nameable": {},
            "minecraft:navigation.walk": {
                "avoid_water": true,
                "can_open_doors": false,
                "can_pass_doors": true,
                "can_path_over_water": false,
                "can_walk": true
            },
            "minecraft:on_hurt": {
                "event": "minecraft:become_angry",
                "filters": {
                    "operator": "!=",
                    "subject": "damager",
                    "test": "is_family",
                    "value": "deer"
                },
                "target": "self"
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:scale": {
                "value": 1
            },
            "minecraft:type_family": {
                "family": ["mob", "deer", "animals"]
            },
            "minecraft:underwater_movement": {
                "value": 0.15
            },
            "minecraft:behavior.delayed_attack": {
                "attack_duration": 0.7,
                "hit_delay_pct": 0.5,
                "reach_multiplier": 1.65,
                "speed_multiplier": 1.0,
                "track_target": true
            }
        },
        "description": {
            "identifier": "legend_forest:magic_deer",
            "is_experimental": false,
            "is_spawnable": true,
            "is_summonable": true,
            "runtime_identifier": "legend_forest:magic_deer"
        },
        "events": {
            "legend_forest:deer_can_hunt": {
                "add": {
                    "component_groups": ["legend_forest:magic_deer_can_hunt"]
                }
            },
            "minecraft:ageable_grow_up": {
                "add": {
                    "component_groups": ["minecraft:magic_deer_adult"]
                },
                "remove": {
                    "component_groups": ["minecraft:magic_deer_baby"]
                }
            },
            "minecraft:become_angry": {
                "add": {
                    "component_groups": ["minecraft:magic_deer_angry"]
                }
            },
            "minecraft:entity_born": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": ["minecraft:magic_deer_baby"]
                        }
                    },
                    {
                        "filters": {
                            "operator": "!=",
                            "test": "has_component",
                            "value": "minecraft:variant"
                        },
                        "randomize": [
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_0"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "!=",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_1"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "!=",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_2"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "==",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_3"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "==",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            }
                        ]
                    }
                ]
            },
            "minecraft:entity_spawned": {
                "sequence": [
                    {
                        "randomize": [
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_adult"
                                    ]
                                },
                                "weight": 60
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_adult",
                                        "legend_forest:magic_deer_can_hunt"
                                    ]
                                },
                                "weight": 35
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_baby"
                                    ]
                                },
                                "weight": 5
                            }
                        ]
                    },
                    {
                        // 仅在尚未有变种时掷一次,避免实体从存档加载时重掷
                        "filters": {
                            "operator": "!=",
                            "test": "has_component",
                            "value": "minecraft:variant"
                        },
                        "randomize": [
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_0"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "!=",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_1"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "!=",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_2"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "==",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            },
                            {
                                "add": {
                                    "component_groups": [
                                        "minecraft:magic_deer_variant_3"
                                    ]
                                },
                                "filters": {
                                    "all_of": [
                                        {
                                            "operator": "==",
                                            "test": "has_biome_tag",
                                            "value": "shimmer_forest"
                                        }
                                    ]
                                },
                                "weight": 50
                            }
                        ]
                    }
                ]
            },
            "minecraft:entity_transformed": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_baby"
                            ]
                        },
                        "filters": {
                            "subject": "other",
                            "test": "has_component",
                            "value": "minecraft:is_baby"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "minecraft:magic_deer_adult"
                            ]
                        },
                        "filters": {
                            "operator": "!=",
                            "subject": "other",
                            "test": "has_component",
                            "value": "minecraft:is_baby"
                        }
                    }
                ]
            },
            "minecraft:on_calm": {
                "remove": {
                    "component_groups": ["minecraft:magic_deer_angry"]
                }
            }
        }
    }
}
