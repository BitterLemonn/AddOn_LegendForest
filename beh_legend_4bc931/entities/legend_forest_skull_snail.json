{
    "format_version": "1.20.0",
    "minecraft:entity": {
        "component_groups": {
            "legend_forest:movement": {
                "minecraft:underwater_movement": {
                    "value": 0.15
                },
                "minecraft:movement": {
                    "value": 0.15
                },
                "minecraft:navigation.climb": {
                    "avoid_damage_blocks": true,
                    "avoid_water": true,
                    "can_open_doors": false,
                    "can_pass_doors": true,
                    "can_path_over_water": false,
                    "can_walk": true
                },
                "minecraft:movement.basic": {},
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "all",
                            "deals_damage": "yes",
                            "on_damage": {
                                "event": "legend_forest:hiding"
                            }
                        }
                    ]
                }
            },
            "legend_forest:hiding_timer": {
                "minecraft:timer": {
                    "time": [5, 10],
                    "looping": false,
                    "time_down_event": {
                        "event": "legend_forest:showing"
                    }
                }
            },
            "legend_forest:hiding": {
                "minecraft:mark_variant": {
                    "value": 1
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "all",
                            "damage_multiplier": 0.45,
                            "on_damage": {
                                "event": "legend_forest:reset_hiding_timer"
                            }
                        }
                    ]
                }
            },
            "legend_forest:showing": {
                "minecraft:mark_variant": {
                    "value": 2
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "all",
                            "deals_damage": "yes"
                        }
                    ]
                },
                "minecraft:timer": {
                    "time": 0.75,
                    "looping": false,
                    "time_down_event": {
                        "event": "legend_forest:hide_over"
                    }
                }
            }
        },
        "components": {
            "minecraft:mark_variant": {
                "value": 0
            },
            "minecraft:collision_box": {
                "height": 0.45,
                "width": 0.55
            },
            "minecraft:health": {
                "max": 10.0,
                "value": 10.0
            },
            "minecraft:nameable": {
            },
            "minecraft:spawn_entity": {
                "entities": {
                    "min_wait_time": 200,
                    "max_wait_time": 400,
                    "spawn_sound": "plop",
                    "spawn_item": "slime_ball",
                    "filters": {
                        "test": "float_property",
                        "domain": "legend_forest:likability",
                        "operator": ">=",
                        "value": 0.65
                    }
                }
            },
            "minecraft:loot": {
                "table": "loot_tables/legend_forest/entities/skull_snail.json"
            },
            "minecraft:interact": {
                "interactions": [
                    {
                        "cooldown": 60,
                        "cooldown_after_being_attacked": 120,
                        "interact_text": "action.interact.legend_forest.skull_snail",
                        "on_interact": {
                            "event": "legend_forest:feed",
                            "filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        },
                                        {
                                            "any_of": [
                                                {
                                                    "test": "has_equipment",
                                                    "subject": "other",
                                                    "domain": "hand",
                                                    "value": "red_mushroom"
                                                },
                                                {
                                                    "test": "has_equipment",
                                                    "subject": "other",
                                                    "domain": "hand",
                                                    "value": "brown_mushroom"
                                                },
                                                {
                                                    "test": "has_equipment",
                                                    "subject": "other",
                                                    "domain": "hand",
                                                    "value": "legend_forest:blue_mushroom"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        "swing": true,
                        "use_item": true
                    }
                ]
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:scale": {
                "value": 1
            },
            "minecraft:type_family": {
                "family": [
                    "undead",
                    "snail",
                    "skull_snail"
                ]
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.look_at_player": {
                "look_distance": 8,
                "priority": 8
            },
            "minecraft:behavior.random_stroll": {
                "priority": 8,
                "speed_multiplier": 0.8
            },
            "minecraft:physics": {
            }
        },
        "description": {
            "identifier": "legend_forest:skull_snail",
            "is_experimental": false,
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "legend_forest:likability": {
                    "type": "float",
                    "default": 0.0,
                    "client_sync": true,
                    "range": [0.0, 1.0]
                }
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "legend_forest:movement"
                    ]
                }
            },
            "legend_forest:hiding": {
                "add": {
                    "component_groups": [
                        "legend_forest:hiding",
                        "legend_forest:hiding_timer"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "legend_forest:movement"
                    ]
                }
            },
            "legend_forest:reset_hiding_timer": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "legend_forest:hiding_timer"
                            ]
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "legend_forest:hiding_timer"
                            ]
                        }
                    }
                ]
            },
            "legend_forest:showing": {
                "remove": {
                    "component_groups": [
                        "legend_forest:hiding",
                        "legend_forest:hiding_timer"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:showing"
                    ]
                }
            },
            "legend_forest:hide_over": {
                "remove": {
                    "component_groups": [
                        "legend_forest:showing"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:movement"
                    ]
                }
            },
            "legend_forest:feed": {
                "set_property": {
                    "legend_forest:likability": "q.property('legend_forest:likability') + math.random(0.1, 0.3) < 1 ? q.property('legend_forest:likability') + math.random(0.1, 0.3) : 1"
                }
            }
        }
    }
}