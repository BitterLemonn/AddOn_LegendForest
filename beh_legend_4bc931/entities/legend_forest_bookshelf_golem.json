{
    "format_version": "1.20.0",
    "minecraft:entity": {
        "component_groups": {
            // 技术性组 - 移除攻击组件防止移动
            "legend_forest:on_attack": {
                "minecraft:movement": {
                    "value": 0.0
                }
            },
            // 技术性组 - 添加攻击组件 用于寻路
            "legend_forest:not_on_attack": {
                "minecraft:movement": {
                    "value": 0.1
                },
                "minecraft:attack": {
                    "damage": 0.0
                }
            },
            // 技术性组 - 面向目标
            "legend_forest:face_target": {
                "minecraft:behavior.look_at_player": {
                    "look_distance": 8,
                    "priority": 8
                },
                "minecraft:behavior.look_at_target": {
                    "look_distance": 8,
                    "priority": 4
                }
            },
            // 技术性组 - 添加地面攻击冷却
            "legend_forest:ground_attack_cd": {
                "minecraft:timer": {
                    "time": [3, 10],
                    "time_down_event": {
                        "event": "legend_forest:ground_attack_cd_over"
                    }
                }
            },
            // 未觉醒状态
            "legend_forest:not_awaken": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:behavior.nearest_attackable_target": {
                    "must_see": true,
                    "reselect_targets": true,
                    "within_radius": 25.0,
                    "must_see_forget_duration": 17.0,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 32.0
                        }
                    ]
                },
                "minecraft:environment_sensor": {
                    "triggers": [
                        {
                            "filters": {
                                "all_of": [
                                    {
                                        "test": "has_target"
                                    },
                                    {
                                        "test": "target_distance",
                                        "operator": "<=",
                                        "value": 8.0
                                    }
                                ]
                            },
                            "event": "legend_forest:awake"
                        }
                    ]
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "deals_damage": "no",
                            "cause": "all",
                            "on_damage": {
                                "event": "legend_forest:on_damage_not_awake"
                            }
                        }
                    ]
                },
                "minecraft:behavior.hurt_by_target": {
                    "must_see": true,
                    "within_radius": 25.0,
                    "must_see_forget_duration": 17.0,
                    "filters": {
                        "all_of": [
                            {
                                "test": "is_family",
                                "subject": "other",
                                "operator": "!=",
                                "value": "bookshelf_golem"
                            }
                        ]
                    }
                }
            },
            // 觉醒动画
            "legend_forest:awaking": {
                "minecraft:timer": {
                    "time": 4.1,
                    "time_down_event": {
                        "event": "legend_forest:awake_over"
                    }
                },
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "deals_damage": "no",
                            "cause": "all"
                        }
                    ]
                }
            },
            // 正常状态
            "legend_forest:alive": {
                "minecraft:movement.basic": {
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "deals_damage": "no",
                            "cause": "magic"
                        },
                        {
                            "cause": "projectile",
                            "damage_multiplier": 0.75
                        },
                        {
                            "cause": "self_destruct",
                            "deals_damage": "no",
                            "on_damage": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "has_damage",
                                            "value": "self_destruct"
                                        }
                                    ]
                                },
                                "target": "self",
                                "event": "legend_forest:die"
                            }
                        }
                    ]
                },
                "minecraft:environment_sensor": {
                    "triggers": [
                        {
                            "filters": {
                                "all_of": [
                                    {
                                        "test": "has_target"
                                    },
                                    {
                                        "test": "target_distance",
                                        "operator": "<=",
                                        "value": 6.0
                                    },
                                    {
                                        "test": "target_distance",
                                        "operator": ">",
                                        "value": 3.5
                                    },
                                    {
                                        "test": "enum_property",
                                        "domain": "legend_forest:on_attack",
                                        "value": "false"
                                    },
                                    {
                                        "test": "enum_property",
                                        "domain": "legend_forest:can_use_ground_attack",
                                        "value": "true"
                                    }
                                ]
                            },
                            "event": "legend_forest:ground_attack"
                        },
                        {
                            "filters": {
                                "all_of": [
                                    {
                                        "test": "has_target"
                                    },
                                    {
                                        "test": "target_distance",
                                        "operator": "<=",
                                        "value": 3.5
                                    },
                                    {
                                        "test": "enum_property",
                                        "domain": "legend_forest:on_attack",
                                        "value": "false"
                                    }
                                ]
                            },
                            "event": "legend_forest:random_choose_attack"
                        }
                    ]
                },
                "minecraft:variant": {
                    "value": 2
                },
                "minecraft:behavior.nearest_attackable_target": {
                    "must_see": true,
                    "reselect_targets": true,
                    "within_radius": 25.0,
                    "must_see_forget_duration": 17.0,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 32.0
                        }
                    ]
                },
                "minecraft:behavior.hurt_by_target": {
                    "must_see": true,
                    "within_radius": 25.0,
                    "must_see_forget_duration": 17.0,
                    "filters": {
                        "all_of": [
                            {
                                "test": "is_family",
                                "subject": "other",
                                "operator": "!=",
                                "value": "bookshelf_golem"
                            }
                        ]
                    }
                }
            },
            // 死亡动画
            "legend_forest:dying": {
                "minecraft:variant": {
                    "value": 3
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "deals_damage": "no",
                            "cause": "all"
                        }
                    ]
                },
                "minecraft:timer": {
                    "time": 2.1,
                    "looping": true,
                    "time_down_event": {
                        "event": "legend_forest:dead"
                    }
                }
            },
            // 死亡状态
            "legend_forest:dead": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:knockback_resistance": {
                "value": 1.0
            },
            "minecraft:collision_box": {
                "height": 1.95,
                "width": 1.0
            },
            "minecraft:health": {
                "max": 150.0,
                "value": 150.0
            },
            "minecraft:equipment": {
                "slot_drop_chance": [
                    {
                        "slot": "slot.weapon.mainhand",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.head",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.chest",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.legs",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.feet",
                        "drop_chance": 0.0
                    }
                ],
                "table": "loot_tables/legend_forest/gear/malfurion_equipment.json"
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 30 + Math.Random(5,10) : 0"
            },
            "minecraft:jump.static": {
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:scale": {
                "value": 1.35
            },
            "minecraft:type_family": {
                "family": [
                    "monster",
                    "mob",
                    "artifact",
                    "bookshelf_golem"
                ]
            },
            "minecraft:underwater_movement": {
                "value": 0.1
            },
            "minecraft:navigation.walk": {
                "avoid_water": true,
                "can_open_doors": false,
                "can_pass_doors": true,
                "can_path_over_water": false,
                "can_walk": true
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.random_stroll": {
                "priority": 8,
                "speed_multiplier": 0.8
            },
            "minecraft:physics": {
            },
            "minecraft:behavior.melee_attack": {
                "priority": 2,
                "speed_multiplier": 1.15,
                "cooldown_time": 9999,
                "track_target": true,
                "require_complete_path": true,
                "reach_multiplier": 0.0
            }
        },
        "description": {
            "identifier": "legend_forest:bookshelf_golem",
            "is_experimental": false,
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "legend_forest:on_attack": {
                    "type": "enum",
                    "values": ["false", "true"],
                    "default": "false",
                    "client_sync": true
                },
                "legend_forest:can_use_ground_attack": {
                    "type": "enum",
                    "values": ["false", "true"],
                    "default": "true",
                    "client_sync": true
                }
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "legend_forest:not_on_attack",
                        "legend_forest:not_awaken"
                    ]
                }
            },
            "legend_forest:ground_attack_cd_over": {
                "remove": {
                    "component_groups": [
                        "legend_forest:ground_attack_cd"
                    ]
                },
                "set_property": {
                    "legend_forest:can_use_ground_attack": "true"
                }
            },
            "legend_forest:random_choose_attack": {
                "sequence": [
                    {
                        "set_property": {
                            "legend_forest:on_attack": "true"
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "legend_forest:can_use_ground_attack",
                            "value": "false"
                        },
                        "trigger": {
                            "event": "legend_forest:lit_attack",
                            "target": "self"
                        }
                    },
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "legend_forest:can_use_ground_attack",
                            "value": "true"
                        },
                        "randomize": [
                            {
                                "weight": 8,
                                "trigger": {
                                    "event": "legend_forest:ground_attack",
                                    "target": "self"
                                }
                            },
                            {
                                "weight": 2,
                                "trigger": {
                                    "event": "legend_forest:lit_attack",
                                    "target": "self"
                                }
                            }
                        ]
                    }
                ]
            },
            "legend_forest:ground_attack": {
                "sequence": [
                    {
                        "set_property": {
                            "legend_forest:on_attack": "true"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "legend_forest:on_attack"
                            ]
                        },
                        "remove": {
                            "component_groups": [
                                "legend_forest:not_on_attack",
                                "legend_forest:facing_target"
                            ]
                        },
                        "randomize": [
                            {
                                "weight": 9,
                                "trigger": {
                                    "event": "legend_forest:ground_attack_general",
                                    "target": "self"
                                }
                            },
                            {
                                "weight": 9,
                                "trigger": {
                                    "event": "legend_forest:ground_attack_fast",
                                    "target": "self"
                                }
                            },
                            {
                                "weight": 2,
                                "trigger": {
                                    "event": "legend_forest:ground_attack_hard",
                                    "target": "self"
                                }
                            }
                        ]
                    }
                ]
            },
            "legend_forest:lit_attack": {
                "sequence": [
                    {
                        "set_property": {
                            "legend_forest:on_attack": "true"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "legend_forest:on_attack"
                            ]
                        },
                        "remove": {
                            "component_groups": [
                                "legend_forest:not_on_attack"
                            ]
                        }
                    }
                ]
            },
            "legend_forest:attack_over": {
                "sequence": [
                    {
                        "filters": {
                            "test": "enum_property",
                            "domain": "legend_forest:on_attack",
                            "value": "true"
                        },
                        "set_property": {
                            "legend_forest:on_attack": "false"
                        },
                        "remove": {
                            "component_groups": [
                                "legend_forest:on_attack"
                            ]
                        },
                        "add": {
                            "component_groups": [
                                "legend_forest:not_on_attack",
                                "legend_forest:facing_target"
                            ]
                        }
                    }
                ]
            },
            "legend_forest:ground_attack_over": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "legend_forest:ground_attack_general",
                                "legend_forest:ground_attack_fast",
                                "legend_forest:ground_attack_hard"
                            ]
                        },
                        "add": {
                            "component_groups": [
                                "legend_forest:ground_attack_cd"
                            ]
                        },
                        "set_property": {
                            "legend_forest:can_use_ground_attack": "false"
                        },
                        "trigger": {
                            "event": "legend_forest:attack_over",
                            "target": "self"
                        }
                    }
                ]
            },
            "legend_forest:ground_attack_general": {
            },
            "legend_forest:ground_attack_fast": {
            },
            "legend_forest:ground_attack_hard": {
            },
            "legend_forest:on_damage_not_awake": {
                "sequence": [
                    {
                        "filters": {
                            "any_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "player"
                                },
                                {
                                    "test": "has_target",
                                    "subject": "other"
                                }
                            ]
                        },
                        "trigger": {
                            "event": "legend_forest:awake"
                        }
                    }
                ]
            },
            "legend_forest:awake": {
                "add": {
                    "component_groups": [
                        "legend_forest:awaking"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "legend_forest:not_awaken"
                    ]
                }
            },
            "legend_forest:awake_over": {
                "remove": {
                    "component_groups": [
                        "legend_forest:awaking"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:alive",
                        "legend_forest:face_target"
                    ]
                }
            },
            "legend_forest:die": {
                "remove": {
                    "component_groups": [
                        "legend_forest:alive",
                        "legend_forest:awaking",
                        "legend_forest:not_awaken",
                        "legend_forest:ground_attack_cd",
                        "legend_forest:on_attack",
                        "legend_forest:not_on_attack"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:dying"
                    ]
                }
            },
            "legend_forest:dead": {
                "remove": {
                    "component_groups": [
                        "legend_forest:dying"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:dead"
                    ]
                }
            }
        }
    }
}