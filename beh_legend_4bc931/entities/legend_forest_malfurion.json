{
    "format_version": "1.20.0",
    "minecraft:entity": {
        "component_groups": {
            // 正常伤害过滤器
            "legend_forest:normal_sensor": {
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "entity_explosion",
                            "deals_damage": false
                        },
                        {
                            "cause": "fire",
                            "deals_damage": false
                        },
                        {
                            "cause": "fire_tick",
                            "deals_damage": false
                        },
                        {
                            "on_damage": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "has_damage",
                                            "value": "self_destruct"
                                        }
                                    ]
                                },
                                "target": "self",
                                "event": "legend_forest:dying"
                            },
                            "deals_damage": false,
                            "cause": "self_destruct"
                        }
                    ]
                }
            },
            // 无敌状态过滤器
            "legend_forest:invincible_sensor": {
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "all",
                            "deals_damage": false
                        }
                    ]
                }
            },
            // 技术性组 - 取消攻击组件 取消寻路
            "legend_forest:on_attack": {
                "minecraft:underwater_movement": {
                    "value": 0.0
                },
                "minecraft:movement": {
                    "value": 0.0
                },
                "minecraft:behavior.look_at_target": {
                    "priority": 0
                }
            },
            // 技术性组 - 添加攻击组件用于寻路
            "legend_forest:not_attack": {
                "minecraft:underwater_movement": {
                    "value": 0.15
                },
                "minecraft:movement": {
                    "value": 0.25
                },
                "minecraft:behavior.ranged_attack": {
                    "priority": 0,
                    "charge_charged_trigger": 0.0,
                    "charge_shoot_trigger": 0.0,
                    "attack_radius_min": 6.0,
                    "attack_interval_min": 0.0,
                    "attack_interval_max": 0.0,
                    "attack_radius": 16.0
                },
                "minecraft:behavior.look_at_target": {
                    "priority": 3
                }
            },
            // 正常状态
            "legend_forest:alive": {
                "minecraft:behavior.nearest_attackable_target": {
                    "attack_interval": 1.0,
                    "entity_types": [
                        {
                            "filters": {
                                "any_of": [
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "player"
                                    },
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "skeleton_guardian"
                                    },
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "irongolem"
                                    },
                                    {
                                        "subject": "other",
                                        "test": "is_family",
                                        "value": "snowgolem"
                                    }
                                ]
                            },
                            "max_dist": 32
                        }
                    ],
                    "must_see": true,
                    "priority": 1,
                    "reselect_targets": true
                },
                "minecraft:behavior.random_stroll": {
                    "priority": 8,
                    "speed_multiplier": 0.8
                }
            },
            // 召唤藤蔓
            "legend_forest:summoner": {
                "minecraft:behavior.summon_entity": {
                    "priority": 0,
                    "summon_choices": [
                        {
                            "cast_duration": 2.0,
                            "cooldown_time": 3.6,
                            "max_activation_range": 4.0,
                            "min_activation_range": 0.0,
                            "particle_color": "#FF664D59",
                            "sequence": [
                                {
                                    "base_delay": 1.0,
                                    "delay_per_summon": 0.0,
                                    "entity_lifespan": 5.5,
                                    "entity_type": "legend_forest:spawn_vine",
                                    "num_entities_spawned": 4,
                                    "shape": "circle",
                                    "size": 1.5,
                                    "sound_event": "prepare.attack",
                                    "target": "self"
                                },
                                {
                                    "base_delay": 1.0,
                                    "delay_per_summon": 0.0,
                                    "entity_lifespan": 5.5,
                                    "entity_type": "legend_forest:spawn_vine",
                                    "num_entities_spawned": 10,
                                    "shape": "circle",
                                    "size": 4.5,
                                    "target": "self"
                                }
                            ],
                            "start_sound_event": "cast.spell",
                            "weight": 2
                        },
                        {
                            "cast_duration": 2.0,
                            "cooldown_time": 1.2,
                            "max_activation_range": 4.0,
                            "min_activation_range": 0.0,
                            "particle_color": "#FF664D59",
                            "sequence": [
                                {
                                    "base_delay": 1.0,
                                    "delay_per_summon": 0.0,
                                    "entity_lifespan": 1.1,
                                    "entity_type": "minecraft:evocation_fang",
                                    "num_entities_spawned": 6,
                                    "shape": "circle",
                                    "size": 1.5,
                                    "sound_event": "prepare.attack",
                                    "target": "self"
                                },
                                {
                                    "base_delay": 1.0,
                                    "delay_per_summon": 0.0,
                                    "entity_lifespan": 1.1,
                                    "entity_type": "minecraft:evocation_fang",
                                    "num_entities_spawned": 12,
                                    "shape": "circle",
                                    "size": 4.5,
                                    "target": "self"
                                }
                            ],
                            "start_sound_event": "cast.spell",
                            "weight": 2
                        },
                        {
                            "cast_duration": 2.0,
                            "cooldown_time": 2.4,
                            "min_activation_range": 3.0,
                            "particle_color": "#FF664D59",
                            "sequence": [
                                {
                                    "base_delay": 1.0,
                                    "delay_per_summon": 0.1,
                                    "entity_lifespan": 5.5,
                                    "entity_type": "legend_forest:spawn_vine",
                                    "num_entities_spawned": 8,
                                    "shape": "line",
                                    "size": 14,
                                    "target": "self"
                                },
                                {
                                    "base_delay": 0.0,
                                    "delay_per_summon": 0.2,
                                    "entity_lifespan": 1.1,
                                    "entity_type": "minecraft:evocation_fang",
                                    "num_entities_spawned": 12,
                                    "shape": "line",
                                    "size": 14,
                                    "target": "self"
                                }
                            ],
                            "start_sound_event": "cast.spell",
                            "weight": 3
                        }
                    ]
                }
            },
            // 死亡动画
            "legend_forest:dying": {
                "minecraft:mark_variant": {
                    "value": 1
                },
                "minecraft:timer": {
                    "time": 2.5,
                    "time_down_event": {
                        "event": "legend_forest:dead"
                    }
                }
            },
            // 死亡状态
            "legend_forest:dead": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:variant": {
                "value": 0
            },
            "minecraft:skin_id": {
                "value": 0
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:can_climb": {
            },
            "minecraft:jump.static": {
            },
            "minecraft:movement.basic": {
            },
            "minecraft:navigation.walk": {
                "avoid_water": true,
                "can_open_doors": true,
                "can_pass_doors": true,
                "can_path_over_water": true,
                "can_walk": true,
                "is_amphibious": true
            },
            "minecraft:equip_item": {},
            "minecraft:mark_variant": {
                "value": 0
            },
            "minecraft:persistent": {
            },
            "minecraft:boss": {
                "hud_range": 55,
                "name": "森茂祭司(化身)"
            },
            "minecraft:collision_box": {
                "height": 1.8,
                "width": 0.75
            },
            "minecraft:equipment": {
                "slot_drop_chance": [
                    {
                        "slot": "slot.weapon.mainhand",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.head",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.chest",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.legs",
                        "drop_chance": 0.0
                    },
                    {
                        "slot": "slot.armor.feet",
                        "drop_chance": 0.0
                    }
                ],
                "table": "loot_tables/legend_forest/gear/malfurion_equipment.json"
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 65 + Math.Random(10,30) : 0"
            },
            "minecraft:health": {
                "max": 200,
                "value": 200
            },
            "minecraft:loot": {
                "table": "loot_tables/legend_forest/entities/malfurion.json"
            },
            "minecraft:knockback_resistance": {
                "value": 0.65
            },
            "minecraft:physics": {
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:scale": {
                "value": 1.0
            },
            "minecraft:type_family": {
                "family": [
                    "mob",
                    "monster",
                    "boss",
                    "malfurion"
                ]
            },
            "minecraft:follow_range": {
                "value": 48
            }
        },
        "description": {
            "identifier": "legend_forest:malfurion",
            "is_experimental": false,
            "is_spawnable": true,
            "is_summonable": true
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "legend_forest:normal_sensor",
                        "legend_forest:alive",
                        "legend_forest:not_attack"
                    ]
                }
            },
            // 死亡动画
            "legend_forest:dying": {
                "add": {
                    "component_groups": [
                        "legend_forest:dying",
                        "legend_forest:on_attack",
                        "legend_forest:invincible_sensor"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "legend_forest:normal_sensor",
                        "legend_forest:not_attack",
                        "legend_forest:alive",
                        "legend_forest:summoner",
                        "legend_forest:not_attack"
                    ]
                }
            },
            // 死亡状态
            "legend_forest:dead": {
                "add": {
                    "component_groups": [
                        "legend_forest:dead"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "legend_forest:dying"
                    ]
                }
            },
            // 传送
            "legend_forest:teleport": {
                "sequence": [
                    {
                        "add": {
                            "component_groups": [
                                "legend_forest:invincible_sensor",
                                "legend_forest:on_attack"
                            ]
                        },
                        "remove": {
                            "component_groups": [
                                "legend_forest:normal_sensor",
                                "legend_forest:not_attack"
                            ]
                        }
                    }
                ]
            },
            // 传送结束
            "legend_forest:teleport_end": {
                "sequence": [
                    {
                        "remove": {
                            "component_groups": [
                                "legend_forest:invincible_sensor",
                                "legend_forest:on_attack"
                            ]
                        },
                        "add": {
                            "component_groups": [
                                "legend_forest:normal_sensor",
                                "legend_forest:not_attack"
                            ]
                        }
                    }
                ]
            },
            // 召唤藤蔓
            "legend_forest:summon_spell": {
                "sequence": [
                    {
                        "set_property": {
                            "legend_forest:on_attack": "true",
                            "legend_forest:can_use_skill": "false"
                        }
                    },
                    {
                        "add": {
                            "component_groups": [
                                "legend_forest:summoner"
                            ]
                        },
                        "remove": {
                            "component_groups": [
                                "legend_forest:not_attack"
                            ]
                        }
                    }
                ]
            },
            // 技能开始
            "legend_forest:skill_start": {
                "remove": {
                    "component_groups": [
                        "legend_forest:not_attack"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:on_attack"
                    ]
                }
            },
            // 技能结束
            "legend_forest:skill_end": {
                "remove": {
                    "component_groups": [
                        "legend_forest:on_attack"
                    ]
                },
                "add": {
                    "component_groups": [
                        "legend_forest:not_attack"
                    ]
                }
            }
        }
    }
}