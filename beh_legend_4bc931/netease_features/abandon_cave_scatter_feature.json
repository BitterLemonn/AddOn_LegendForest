        "y": "t.ry=t.valid?t.cy+t.iy:-999;t.iz=t.iz+1;t.row=t.iz>2;t.iz=t.row?-2:t.iz;t.iy=t.row?t.iy+1:t.iy;t.layer=t.iy>2;t.iy=t.layer?-2:t.iy;t.ix=t.layer?t.ix+1:t.ix;t.done=t.ix>2;t.ix=t.done?-2:t.ix;t.at_branch=t.done?(t.phase==0?t.center==t.branch_at:0):0;t.bx=t.at_branch?t.cx:t.bx;t.by=t.at_branch?t.cy:t.by;t.bz=t.at_branch?t.cz:t.bz;t.bheading=t.at_branch?math.mod(t.heading+(math.random_integer(0,1)==0?2:6),8):t.bheading;t.main_done=t.done?(t.phase==0?t.center>=t.main_len-1:0):0;t.phase=t.main_done?1:t.phase;t.cx=t.main_done?t.bx:t.cx;t.cy=t.main_done?t.by:t.cy;t.cz=t.main_done?t.bz:t.cz;t.heading=t.main_done?t.bheading:t.heading;t.run=t.main_done?math.random_integer(3,5):t.run;t.dy=t.main_done?math.random_integer(-1,1):t.dy;t.hr=t.main_done?math.random_integer(1,2):t.hr;t.vr=t.main_done?math.random_integer(1,2):t.vr;t.move=t.done*(1-t.main_done);t.run=t.move?t.run-1:t.run;t.new_run=t.move?(t.run<=0):0;t.turn=t.new_run?math.random_integer(1,3):0;t.heading=t.new_run?math.mod(t.heading+(math.random_integer(0,1)==0?t.turn:8-t.turn),8):t.heading;t.run=t.new_run?math.random_integer(3,5):t.run;t.dy=t.new_run?math.random_integer(-1,1):t.dy;t.hr=t.new_run?math.random_integer(1,2):t.hr;t.vr=t.new_run?math.random_integer(1,2):t.vr;t.dx=(t.heading==0||t.heading==1||t.heading==7)?1:((t.heading==3||t.heading==4||t.heading==5)?-1:0);t.dz=(t.heading==1||t.heading==2||t.heading==3)?1:((t.heading==5||t.heading==6||t.heading==7)?-1:0);t.cx=t.move?t.cx+t.dx:t.cx;t.cz=t.move?t.cz+t.dz:t.cz;t.ny=t.cy+t.dy;t.dy=t.move?(t.ny>4?-1:(t.ny<-4?1:t.dy)):t.dy;t.cy=t.move?t.cy+t.dy:t.cy;t.center=t.done?t.center+1:t.center;return t.ry;",
        "z": "t.valid=(t.ix*t.ix+t.iz*t.iz)*t.vr*t.vr+t.iy*t.iy*t.hr*t.hr<=t.hr*t.hr*t.vr*t.vr;return t.valid?t.cz+t.iz:0;"
    }
