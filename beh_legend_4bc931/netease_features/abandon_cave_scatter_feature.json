{
    "format_version": "1.13.0",
    "minecraft:scatter_feature": {
        "description": {
            "identifier": "legend_forest:abandon_cave_scatter_feature"
        },
        "places_feature": "legend_forest:abandon_cave_air_feature",
        "iterations": "t.seg_r=math.random_integer(2,3);t.seg_count=t.seg_r>2?math.random_integer(10,18):math.random_integer(15,25);t.step=t.seg_r*0.8;t.h_angle=math.random_integer(0,360)*0.01745;t.sharp_every=math.random_integer(2,3);t.sharp_ctr=0;t.vy=0;t.px=0;t.py=0;t.pz=0;t.cur_seg=0;t.sr=t.seg_r;t.wobble=math.random_integer(1,3)*0.5;t.ix=-t.sr;t.iy=-t.sr;t.iz=-t.sr;return t.seg_count*math.pow(2*t.sr+1,3);",
        "coordinate_eval_order": "zxy",
        "x": "t.valid?(t.px+t.cx):0",
        "y": "t.valid?(t.py+t.cy):-999",
        "z": "t.ns=t.iy>t.sr&&t.cur_seg<t.seg_count;t.h_angle=t.ns?(t.h_angle+(math.random_integer(0,100)*0.01-0.5)*1.2+math.sin(t.cur_seg*t.wobble)*0.3):t.h_angle;t.sharp_ctr=t.ns?t.sharp_ctr+1:t.sharp_ctr;t.do_sharp=t.ns&&t.sharp_ctr>=t.sharp_every&&t.cur_seg>0;t.sharp_ctr=t.do_sharp?0:t.sharp_ctr;t.h_angle=t.do_sharp?math.random_integer(0,360)*0.01745:t.h_angle;t.vy=t.do_sharp?((math.random_integer(0,6)-3)*2.0):(t.ns?(t.vy*0.4+(math.random_integer(0,8)-4)*0.5):t.vy);t.px=t.ns?(t.px+math.cos(t.h_angle)*t.step):t.px;t.py=t.ns?(t.py+t.vy):t.py;t.pz=t.ns?(t.pz+math.sin(t.h_angle)*t.step):t.pz;t.cur_seg=t.ns?t.cur_seg+1:t.cur_seg;t.ix=t.ns?-t.sr:t.ix;t.iy=t.ns?-t.sr:t.iy;t.iz=t.ns?-t.sr:t.iz;t.cx=t.ix;t.cy=t.iy;t.cz=t.iz;t.d=t.cx*t.cx+t.cy*t.cy+t.cz*t.cz;t.check_r=t.seg_r+0.5;t.valid=t.cur_seg<t.seg_count&&t.d<=t.check_r*t.check_r;t.rz=t.valid?(t.pz+t.cz):0;t.iz=t.iz+1;t.eoz=t.iz>t.sr;t.iz=t.eoz?-t.sr:t.iz;t.ix=t.eoz?t.ix+1:t.ix;t.eox=t.ix>t.sr;t.ix=t.eox?-t.sr:t.ix;t.iy=t.eox?t.iy+1:t.iy;return t.rz;"
    }
}
