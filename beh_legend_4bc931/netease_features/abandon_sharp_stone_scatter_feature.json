{
    "format_version": "1.13.0",
    "minecraft:scatter_feature": {
        "description": {
            "identifier": "legend_forest:abandon_sharp_stone_scatter_feature"
        },
        "places_feature": "legend_forest:abandon_sharp_stone_random_feature",
        "iterations": "t.level=0;t.cur_r=t.radius;t.ix=-t.radius;t.iz=-t.radius;t.dx=t.direction==0?-1:(t.direction==1?1:0);t.dz=t.direction==2?-1:(t.direction==3?1:0);return t.temp_step*t.radius*(4*t.radius*t.radius+12*t.radius+11)/3;",
        "coordinate_eval_order": "zxy",
        "x": "t.valid?(t.cx+t.level*t.dx):0",
        "y": "t.valid?t.level:-999",
        "z": "t.cx=t.ix;t.valid=(t.ix*t.ix+t.iz*t.iz)<=t.cur_r*t.cur_r;t.rz=t.iz+t.level*t.dz;t.iz=t.iz+1;t.row=t.iz>t.cur_r;t.iz=t.row?-t.cur_r:t.iz;t.ix=t.row?t.ix+1:t.ix;t.layer=t.ix>t.cur_r;t.level=t.layer?t.level+1:t.level;t.cur_r=t.layer?t.radius-math.floor(t.level/t.temp_step):t.cur_r;t.ix=t.layer?-t.cur_r:t.ix;t.iz=t.layer?-t.cur_r:t.iz;return t.valid?t.rz:0;"
    }
}