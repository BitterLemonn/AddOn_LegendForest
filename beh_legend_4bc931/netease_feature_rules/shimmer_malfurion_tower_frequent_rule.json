                        {
                            "operator": "==",
                            "test": "has_biome_tag",
                            "value": "shimmer_forest_hills"
                        },
                        {
                            "operator": "==",
                            "test": "has_biome_tag",
                            "value": "shimmer_flower_forest"
                        }
                    ]
                }
            ],
            "placement_pass": "surface_pass"
        },
        "description": {
            "identifier": "legend_forest:shimmer_malfurion_tower_frequent_rule",
            "places_feature": "legend_forest:shimmer_mal_tower_random_frequent_feature"
        },
        "distribution": {
            "coordinate_eval_order": "zxy",
