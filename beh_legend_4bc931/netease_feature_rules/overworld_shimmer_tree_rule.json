{
    "format_version": "1.13.0",
    "minecraft:feature_rules": {
        "conditions": {
            "minecraft:biome_filter": [
                {
                    "any_of": [
                        {
                            "operator": "==",
                            "test": "has_biome_tag",
                            "value": "forest"
                        },
                        {
                            "operator": "==",
                            "test": "has_biome_tag",
                            "value": "jungle"
                        },
                        {
                            "operator": "==",
                            "test": "has_biome_tag",
                            "value": "savanna"
                        }
                    ]
                }
            ],
            "placement_pass": "surface_pass"
        },
        "description": {
            "identifier": "legend_forest:overworld_shimmer_tree_rule",
            "places_feature": "legend_forest:overworld_shimmer_tree_feature"
        },
        "distribution": {
            "coordinate_eval_order": "zxy",
            "iterations": "math.random(0,1) > 0.8 ? (q.noise(v.originx, v.originz) < 0.45 ? 1 : 0) : 0",
            "x": {
                "distribution": "uniform",
                "extent": [
                    0,
                    16
                ]
            },
            "y": "q.heightmap(v.originx, v.originz)",
            "z": {
                "distribution": "uniform",
                "extent": [
                    0,
                    16
                ]
            }
        }
    }
