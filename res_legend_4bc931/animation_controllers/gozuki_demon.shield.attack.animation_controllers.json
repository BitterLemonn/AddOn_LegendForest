{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gozuki_demon.shield.attack": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "has_target": "query.has_target && query.mod.skill_id == 0.0"
                        },
                        {
                            "block": "query.mod.skill_id == 1.0"
                        },
                        {
                            "attack": "query.mod.skill_id == 2.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "has_target": {
                    "animations": ["has_target"],
                    "transitions": [
                        {
                            "default": "!query.has_target"
                        },
                        {
                            "block": "query.mod.skill_id == 1.0"
                        },
                        {
                            "attack": "query.mod.skill_id == 2.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "block": {
                    "animations": ["block"],
                    "transitions": [
                        {
                            "default": "query.mod.skill_id == 0.0"
                        },
                        {
                            "counter": "query.mod.skill_id == 3.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "attack": {
                    "animations": ["shield_attack"],
                    "transitions": [
                        {
                            "default": "query.mod.skill_id == 0.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "counter": {
                    "animations": ["counter"],
                    "transitions": [
                        {
                            "default": "query.mod.skill_id == 0.0"
                        }
                    ],
                    "blend_transition": 0.2
                }
            }
        }
    }
}
