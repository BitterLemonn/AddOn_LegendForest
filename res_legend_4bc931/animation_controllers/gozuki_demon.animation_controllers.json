{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.gozuki_demon.common": {
            "initial_state": "default",
            "states": {
                "move": {
                    "animations": ["move"],
                    "transitions": [
                        {
                            "default": "q.ground_speed <= 0.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "default": {
                    "animations": ["idle","bob"],
                    "transitions": [
                        {
                            "move": "q.ground_speed > 0.0"
                        }
                    ],
                    "blend_transition": 0.2
                }
            }
        }
    }
}
