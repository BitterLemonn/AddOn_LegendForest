{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "legend_forest:bell_ghost_spirituality",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/bell_ghost_spirituality"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "math.random(0.25, 2)",
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 5
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.sin(v.particle_age * 90)", -4, "math.cos(v.particle_age * 40)"],
				"linear_drag_coefficient": 5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(variable.particle_random_1 * 0.15 + 0.02) * (v.particle_lifetime - v.particle_age) / v.particle_lifetime", "(variable.particle_random_1 * 0.15 + 0.02) * (v.particle_lifetime - v.particle_age) / v.particle_lifetime"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime / variable.particle_random_2",
					"gradient": {
						"0.0": "#FF239FFF",
						"0.5": "#FF7DEDE3",
						"1.0": "#FFBAF2F6"
					}
				}
			}
		}
	}
}