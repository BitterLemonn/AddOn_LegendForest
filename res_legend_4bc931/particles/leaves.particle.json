{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "legend_forest:leaves_fall",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/leaves_particle"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0, 0],
				"half_dimensions": [0.45, 0, 0.45],
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 20
			},
