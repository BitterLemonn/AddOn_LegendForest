            },
            "enable_attachables": true,
            "hide_armor": true,
            "geometry": {
                "default": "geometry.malfurion"
            },
            "identifier": "legend_forest:malfurion",
            "materials": {
                "default": "entity_emissive_alpha"
            },
            "render_controllers": [
                "controller.render.default"
            ],
            "particle_effects": {
                "malfurion_portal": "legend_forest:malfurion_portal",
                "dead_ruin": "legend_forest:dead_ruin",
                "dead_smoke": "legend_forest:dead_smoke",
                "fire_ruin": "legend_forest:fire_ruin_once",
                "fire_wand": "legend_forest:fire_wand_particle_once",
