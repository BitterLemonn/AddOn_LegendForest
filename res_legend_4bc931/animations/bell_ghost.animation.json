{
	"format_version": "1.8.0",
	"animations": {
		"animation.bell_ghost.move": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved / 10",
			"bones": {
				"head": {
					"rotation": [0, 0, "math.sin(query.anim_time * 90) * 20"],
					"position": ["math.sin(query.anim_time * 45) * 2", "math.sin(query.anim_time * 60) * 2", 0]
				}
			},
			"particle_effects": {
				"0.0": {
					"effect": "bell_ghost",
					"locator": "tail"
				}
			}
		},
		"animation.bell_ghost.bob": {
			"loop": true,
			"bones": {
				"leftArm": {
					"rotation": [0, 0, "-15 + math.cos(query.anim_time * 45) * 15 "],
					"position": [0, "math.sin(query.anim_time * 45)", 0]
				},
				"rightArm": {
					"rotation": [0, 0, "15 - math.cos(query.anim_time * 45) * 15 "],
					"position": [0, "math.sin(query.anim_time * 45)", 0]
				}
			}
		}
	}
}