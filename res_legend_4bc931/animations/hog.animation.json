{
    "animations": {
        "animation.hog.attack": {
            "bones": {
                "head": {
                    "rotation": ["variable.attack_head_rot", 0, 0]
                }
            },
            "loop": true,
            "particle_effects": {}
        },
        "animation.hog.baby_scaling": {
            "animation_length": 2.641,
            "bones": {
                "head": {
                    "position": [0, 0, 4],
                    "scale": 1.4
                }
            },
            "loop": true
        },
        "animation.hog.look_at_target": {
            "bones": {
                "head": {
                    "relative_to": {
                        "rotation": "entity"
                    },
                    "rotation": [0, "query.target_y_rotation - this", 0]
                }
            },
            "loop": true
        },
        "animation.hog.walk": {
            "bones": {
                "left_ear": {
                    "rotation": [0, 0, "variable.tcos_left_side * 0.5"]
                },
                "leg_back_left": {
                    "rotation": ["variable.tcos_left_side", 0, 0]
                },
                "leg_back_right": {
                    "rotation": ["variable.tcos_right_side", 0, 0]
                },
                "leg_front_left": {
                    "rotation": ["-variable.tcos_left_side", 0, 0]
                },
                "leg_front_right": {
                    "rotation": ["-variable.tcos_right_side", 0, 0]
                },
                "right_ear": {
                    "rotation": [0, 0, "variable.tcos_right_side * 0.5"]
                }
            },
            "loop": true
        },
        "animation.hog.idle": {
            "bones": {
                "tail": {
                    "rotation": ["math.sin(query.anim_time * 97.98) * 15", "math.sin(query.anim_time * 186.75) * 30", 0]
                },
                "mouse": {
                    "rotation": ["math.sin(query.anim_time * 56.7) * 5", 0, 0]
                }
            },
            "loop": true
        }
    },
    "format_version": "1.8.0"
}