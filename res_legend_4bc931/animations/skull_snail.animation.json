{
	"format_version": "1.8.0",
	"animations": {
		"animation.skull_snail.idle": {
			"loop": true,
			"bones": {
				"leftEye": {
					"rotation": [0, 0, "-math.sin(query.anim_time * 42.8) * 6"]
				},
				"rightEye": {
					"rotation": [0, 0, "math.sin(query.anim_time * 36.8) * 6"]
				}
			}
		},
		"animation.skull_snail.move": {
			"loop": true,
			"anim_time_update": "q.modified_distance_moved",
			"bones": {
				"shell": {
					"rotation": [0, 0, "math.sin(query.anim_time * 36.21) * 8.5"]
				},
				"leftEye": {
					"rotation": ["math.sin(query.anim_time * 46.2) * 5", 0, 0]
				},
				"rightEye": {
					"rotation": ["math.sin(query.anim_time * 46.2) * 5", 0, 0]
				}
			}
		},
		"animation.skull_snail.bob": {
			"loop": true,
			"bones": {
				"rightBeard": {
					"rotation": [0, "math.sin(query.anim_time * 38.24) * 5", 0],
					"scale": "math.sin(query.anim_time * 38.24) * 0.05 + 1"
				},
				"leftBeard": {
					"rotation": [0, "-math.sin(query.anim_time * 38.24) * 5", 0],
					"scale": "math.sin(query.anim_time * 38.24) * 0.05 + 1"
				}
			}
		},
		"animation.skull_snail.hide": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.5,
			"bones": {
				"body": {
					"scale": {
						"0.0": [1, 1, 1],
						"0.25": {
							"pre": [0.5, 0.5, 0.5],
							"post": [0, 0, 0]
						}
					}
				},
				"shell": {
					"rotation": {
						"0.125": [0, 0, 0],
						"0.3333": [12.5, 0, 0]
					},
					"position": {
						"0.125": [0, 0, 0],
						"0.3333": [0, -2, 0]
					}
				},
				"leftEye": {
					"rotation": {
						"0.0": [0, 0, 0],
						"0.125": [50, 0, 0]
					}
				},
				"rightEye": {
					"rotation": {
						"0.0": [0, 0, 0],
						"0.125": [50, 0, 0]
					}
				}
			}
		},
		"animation.skull_snail.show": {
			"loop": "hold_on_last_frame",
			"animation_length": 1,
			"bones": {
				"body": {
					"scale": {
						"0.0": [0, 0, 0],
						"0.25": {
							"pre": [0, 0, 0],
							"post": [0.5, 0.5, 0.5]
						},
						"0.75": [1, 1, 1]
					}
				},
				"shell": {
					"rotation": {
						"0.25": [12.5, 0, 0],
						"0.75": [0, 0, 0]
					},
					"position": {
						"0.25": [0, -2, 0],
						"0.75": [0, 0, 0]
					}
				},
				"leftEye": {
					"rotation": {
						"0.25": [50, 0, 0],
						"0.75": [0, 0, 0]
					}
				},
				"rightEye": {
					"rotation": {
						"0.25": [50, 0, 0],
						"0.75": [0, 0, 0]
					}
				}
			}
		},
		"animation.skull_snail.vertical": {
			"loop": true,
			"bones": {
				"root": {
					"rotation": [-90, 0, 0],
					"position": [0, 8, -8]
				}
			}
		}
	}
}